# formal-hitl LLM configuration
#
# Any OpenAI-compatible endpoint works here. Default target is Groq's free
# tier (no credit card required): create a key at https://console.groq.com/keys
#
# Because llm.py only speaks the OpenAI-compatible chat-completions API, you
# can later point this at a local JLSE GPU-node model (Ollama/vLLM) or an
# ALCF-hosted endpoint by changing only these three variables.
#
# Copy this file to `.env` (which is gitignored) and fill in your own key --
# never commit real credentials to `.env.example`.

LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=your-groq-api-key-here
